{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext", // Ou "Node16"
    "target": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"], // Adicione isto
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}
